# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh installation.

# Profile ZSH
# zmodload zsh/zprof

plugins=(
  zsh-nvm
  git
  aws
  npm
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
)

export ZSH="$HOME/.oh-my-zsh"
export NVM_LAZY_LOAD=true
export NVM_COMPLETION=true
export ZSH_THEME="powerlevel10k/powerlevel10k"

source "$ZSH/oh-my-zsh.sh"

# Enable pyenv
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# Profile ZSH
# zprof

# Load Powerlevel10k
# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
export PATH="$HOME/.local/bin:$PATH"

# Secrets are pulled lazily from 1Password at shell startup, never stored
# in this file or in git. Requires the 1Password desktop app to be signed
# in with CLI integration enabled.
export ANTHROPIC_API_KEY="$(op read 'op://Development/Anthropic API Key/credential' 2>/dev/null)"
export OBSIDIAN_TOKEN="$(op read 'op://Development/Obsidian REST Key/credential' 2>/dev/null)"

# 1Password CLI shell plugins (aws, gh, etc.) — must load after oh-my-zsh
# so the op-wrapped `aws` function takes precedence over oh-my-zsh's
# bundled aws plugin.
[[ -f ~/.config/op/plugins.sh ]] && source ~/.config/op/plugins.sh
