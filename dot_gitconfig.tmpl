[user]
	name = Smitty Weygant
	email = smittoid@hotmail.com
[alias]
	lg = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
[init]
	defaultBranch = main
{{- if eq .chezmoi.os "windows" }}
# Git for Windows bundles its own ssh, which cannot reach 1Password's agent
# named pipe. The system OpenSSH can. It also reads the Windows ~/.ssh/config,
# which holds the host aliases (unmanaged; see CLAUDE.md).
[core]
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- else if includeTemplate "is-wsl" . }}
# Under WSL, use Windows' ssh.exe so git reaches the 1Password agent on the
# Windows side. Host aliases such as github-akka must exist in the Windows
# ~/.ssh/config.
[core]
	sshCommand = ssh.exe
{{- end }}
# Work repos live under ~/akka/ and use a separate SSO-authorized identity/key;
# see dot_gitconfig-akka.
[includeIf "gitdir:~/akka/"]
	path = .gitconfig-akka
# Per-machine overrides (e.g. a work [user] name/email). Untracked; git silently
# ignores the include if the file doesn't exist. Keep this last so it wins.
[include]
	path = ~/.gitconfig.local
