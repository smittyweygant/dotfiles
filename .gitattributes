# Automatically normalize line endings for all text-based files
#* text=auto
# Disabled because of https://github.com/mathiasbynens/dotfiles/issues/149 :(

# Scripts run under bash on every OS, including a Windows checkout used by WSL.
*.sh text eol=lf
*.sh.tmpl text eol=lf
executable_* text eol=lf

# PowerShell reads LF fine; keep the Windows scripts like the shell ones.
*.ps1 text eol=lf
*.ps1.tmpl text eol=lf
