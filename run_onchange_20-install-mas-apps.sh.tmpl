#!/usr/bin/env bash
# MASfile hash: {{ include "MASfile" | sha256sum }}
# Re-runs automatically whenever MASfile's content changes.
set -euo pipefail

if ! command -v mas >/dev/null 2>&1; then
  echo "mas not found — should have been installed via Brewfile first"
  exit 1
fi

# Note: mas >= 6 dropped `mas account`, so there's no CLI sign-in check.
# You must already be signed in to the App Store app; if not, each install
# below fails and is reported. This script only re-runs when MASfile changes,
# so after signing in, install the failures by hand with `mas install <id>`.
while read -r id name; do
  [ -z "$id" ] && continue
  case "$id" in \#*) continue ;; esac
  mas install "$id" || echo "Failed to install $name ($id) — not signed in to the App Store, or not available under this Apple ID"
done < "{{ .chezmoi.sourceDir }}/MASfile"
