{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectInfrastructure",
      "Effect": "Allow",
      "Action": ["ec2:*", "ecr:*", "ssm:*", "route53:*"],
      "Resource": "*"
    },
    {
      "Sid": "FinancesBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::finances-deploy-${aws:PrincipalAccount}"
    },
    {
      "Sid": "FinancesBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::finances-deploy-${aws:PrincipalAccount}/releases/*",
        "arn:aws:s3:::finances-deploy-${aws:PrincipalAccount}/backups/*",
        "arn:aws:s3:::finances-deploy-${aws:PrincipalAccount}/models/*",
        "arn:aws:s3:::finances-deploy-${aws:PrincipalAccount}/archive/*"
      ]
    },
    {
      "Sid": "NoSecretsFromParameterStore",
      "Effect": "Deny",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:*:*:parameter/finances/*"
    },
    {
      "Sid": "NoWritingProductionSecrets",
      "Effect": "Deny",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:LabelParameterVersion",
        "ssm:UnlabelParameterVersion"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/finances/*"
    },
    {
      "Sid": "NoInteractiveShellOnHosts",
      "Effect": "Deny",
      "Action": ["ssm:StartSession"],
      "Resource": "*"
    }
  ]
}
