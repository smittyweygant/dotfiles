[user]
	name = Smitty Weygant
	email = smittoid@hotmail.com
[alias]
	lg = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
[init]
	defaultBranch = main
# Work repos live under ~/akka/ and use a separate SSO-authorized identity/key;
# see dot_gitconfig-akka.
[includeIf "gitdir:~/akka/"]
	path = .gitconfig-akka
# Per-machine overrides (e.g. a work [user] name/email). Untracked; git silently
# ignores the include if the file doesn't exist. Keep this last so it wins.
[include]
	path = ~/.gitconfig.local
